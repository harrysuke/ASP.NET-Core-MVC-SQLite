@model mvc.Models.BookViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1 class="h3 mb-3">Delete book</h1>

<div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
    Are you sure you want to delete this book? This action cannot be undone.
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2 text-body-secondary">Title</dt>
            <dd class="col-sm-10">@Model.Title</dd>
            <dt class="col-sm-2 text-body-secondary">Author</dt>
            <dd class="col-sm-10">@Model.Author</dd>
            <dt class="col-sm-2 text-body-secondary">Price</dt>
            <dd class="col-sm-10">@($"{Model.Price:N0}")</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent">
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>