@model mvc.Models.BookViewModel

@{
    ViewData["Title"] = "Book details";
}

<h1 class="h3 mb-3">Book details</h1>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2 text-body-secondary">Title</dt>
            <dd class="col-sm-10">@Model.Title</dd>
            <dt class="col-sm-2 text-body-secondary">Author</dt>
            <dd class="col-sm-10">@Model.Author</dd>
            <dt class="col-sm-2 text-body-secondary">Price</dt>
            <dd class="col-sm-10">@($"{Model.Price:N0}")</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
</div>