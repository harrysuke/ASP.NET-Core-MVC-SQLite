@model mvc.Models.UserListViewModel

@{
    ViewData["Title"] = "Delete user";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-danger">
            <div class="card-header bg-transparent border-danger text-danger">
                <h1 class="h5 mb-0">Delete user</h1>
            </div>
            <div class="card-body">
                <p class="mb-3">Are you sure you want to delete this user? This action cannot be undone.</p>
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-body-secondary">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4 text-body-secondary">Username</dt>
                    <dd class="col-sm-8">@Model.UserName</dd>
                </dl>
            </div>
            <div class="card-footer bg-transparent">
                <form asp-action="Delete" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
            </div>
        </div>
    </div>
</div>