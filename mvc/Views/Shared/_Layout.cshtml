@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{
    string? controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string? action = ViewContext.RouteData.Values["action"]?.ToString();
    bool isAuthPage = controller == "Account" && (action == "Login" || action == "Register"
        || action == "ForgotPassword" || action == "ForgotPasswordConfirmation"
        || action == "ResetPassword" || action == "ResetPasswordConfirmation");
    bool isLanding = controller == "Home" && action == "Index" && !SignInManager.IsSignedIn(User);
    bool hideSidebar = isAuthPage || isLanding;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" data-theme-color-light="#ffffff" data-theme-color-dark="#212529" />
    <title>@ViewData["Title"] - mvc</title>
    <script>
        // Apply the saved/system theme before any CSS paints to avoid a flash of the wrong mode.
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('theme'); } catch (e) { }
            var theme = (stored === 'light' || stored === 'dark')
                ? stored
                : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/mvc.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-sm bg-body-tertiary border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">MVC</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-body" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-body" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-body" asp-area="" asp-controller="Book" asp-action="Index">List</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-body" asp-area="" asp-controller="Book" asp-action="Create">Create</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-body" asp-area="" asp-controller="Home" asp-action="Api">API</a>
                            </li>
                            @if (User?.IsInRole("Admin") == true)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-body" asp-area="" asp-controller="User" asp-action="Index">Users</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-body" asp-area="" asp-controller="AuditLog" asp-action="Index">Audit</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-body" asp-area="" asp-controller="Analytics" asp-action="Index">Analytics</a>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-body" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @User?.Identity?.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profile</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <span class="dropdown-item-text text-body-secondary">@User?.Identity?.Name</span>
                                    </li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="btn btn-sm btn-outline-secondary theme-toggle rounded-circle d-flex align-items-center justify-content-center p-2 ms-2"
                                        data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode" title="Switch to dark mode">
                                    <svg class="theme-icon-sun" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 1a5 5 0 1 1 0-10 5 5 0 0 1 0 10zM8 0a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0v-1A.5.5 0 0 1 8 0zm0 14a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0v-1A.5.5 0 0 1 8 14zm7.5-6a.5.5 0 0 1 0 1h-1a.5.5 0 0 1 0-1h1zM1.5 8a.5.5 0 0 1 0 1h-1a.5.5 0 0 1 0-1h1zm11.33-4.88a.5.5 0 0 1 .7 0l.71.71a.5.5 0 0 1-.7.71l-.71-.71a.5.5 0 0 1 0-.71zM1.96 10.46a.5.5 0 0 1 .7.7l-.7.7a.5.5 0 0 1-.71-.7l.71-.7zm11.08 2.48a.5.5 0 0 1-.7.71l-.71-.7a.5.5 0 0 1 .7-.71l.71.7zM2.26 3.12a.5.5 0 0 1-.7.71l-.71-.71a.5.5 0 0 1 .7-.7l.71.7z"/>
                                    </svg>
                                    <svg class="theme-icon-moon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z"/>
                                    </svg>
                                </button>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item">
                                <a class="nav-link text-body" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-body" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="btn btn-sm btn-outline-secondary theme-toggle rounded-circle d-flex align-items-center justify-content-center p-2 ms-2"
                                        data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode" title="Switch to dark mode">
                                    <svg class="theme-icon-sun" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 1a5 5 0 1 1 0-10 5 5 0 0 1 0 10zM8 0a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0v-1A.5.5 0 0 1 8 0zm0 14a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0v-1A.5.5 0 0 1 8 14zm7.5-6a.5.5 0 0 1 0 1h-1a.5.5 0 0 1 0-1h1zM1.5 8a.5.5 0 0 1 0 1h-1a.5.5 0 0 1 0-1h1zm11.33-4.88a.5.5 0 0 1 .7 0l.71.71a.5.5 0 0 1-.7.71l-.71-.71a.5.5 0 0 1 0-.71zM1.96 10.46a.5.5 0 0 1 .7.7l-.7.7a.5.5 0 0 1-.71-.7l.71-.7zm11.08 2.48a.5.5 0 0 1-.7.71l-.71-.7a.5.5 0 0 1 .7-.71l.71.7zM2.26 3.12a.5.5 0 0 1-.7.71l-.71-.71a.5.5 0 0 1 .7-.7l.71.7z"/>
                                    </svg>
                                    <svg class="theme-icon-moon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z"/>
                                    </svg>
                                </button>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
        <partial name="_LoginPartial"/>
    </header>
    <div class="container-fluid">
        <div class="row">
            @if (!hideSidebar)
            {
                <aside class="col-md-3 col-lg-2 bg-body-tertiary border-end sidebar p-3">
                    <h5 class="sidebar-heading">Menu</h5>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Book" asp-action="Index">List</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Book" asp-action="Create">Create</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Api">API</a>
                        </li>
                        @if (User?.IsInRole("Admin") == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="User" asp-action="Index">Users</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="AuditLog" asp-action="Index">Audit</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Analytics" asp-action="Index">Analytics</a>
                            </li>
                        }
                    </ul>
                </aside>
            }
            <main id="main" role="main" class="pb-3 @(hideSidebar ? "" : "col-md-9 col-lg-10")">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer text-body-secondary">
        <div class="container">
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
