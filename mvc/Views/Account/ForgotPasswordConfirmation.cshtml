@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 text-center">
                <h1 class="h3 mb-3">Check your inbox</h1>
                <p class="text-body-secondary mb-4">
                    If the email you entered belongs to an account, a password reset link has been sent.
                    Please check your inbox to continue.
                </p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Back to login</a>
            </div>
        </div>
    </div>
</div>