@model mvc.Models.ProfilePageViewModel
@{
    ViewData["Title"] = "Profile";
    bool showEdit = Model.ShowEdit;
}

<h1 class="h3 mb-3">Profile</h1>

@if (TempData["ProfileSuccess"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["ProfileSuccess"]</div>
}
@if (TempData["PasswordSuccess"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["PasswordSuccess"]</div>
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Account information</span>
                @if (!showEdit)
                {
                    <button type="button" id="btnEditProfile" class="btn btn-sm btn-outline-primary">Update</button>
                }
            </div>
            <div class="card-body">
                @if (!showEdit)
                {
                    <dl class="row mb-0" id="profileDisplay">
                        <dt class="col-sm-4 text-body-secondary">Username</dt>
                        <dd class="col-sm-8">@Model.Profile.UserName</dd>
                        <dt class="col-sm-4 text-body-secondary">Email</dt>
                        <dd class="col-sm-8">@Model.Profile.Email</dd>
                        <dt class="col-sm-4 text-body-secondary">Phone</dt>
                        @if (string.IsNullOrEmpty(Model.Profile.PhoneNumber))
                        {
                            <dd class="col-sm-8">&mdash;</dd>
                        }
                        else
                        {
                            <dd class="col-sm-8">@Model.Profile.PhoneNumber</dd>
                        }
                        <dt class="col-sm-4 text-body-secondary">Email confirmed</dt>
                        <dd class="col-sm-8">
                            @if (Model.Profile.EmailConfirmed)
                            {
                                <span class="badge text-bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">No</span>
                            }
                        </dd>
                        <dt class="col-sm-4 text-body-secondary">Phone confirmed</dt>
                        <dd class="col-sm-8">
                            @if (Model.Profile.PhoneNumberConfirmed)
                            {
                                <span class="badge text-bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">No</span>
                            }
                        </dd>
                        <dt class="col-sm-4 text-body-secondary">Two-factor enabled</dt>
                        <dd class="col-sm-8">
                            @if (Model.Profile.TwoFactorEnabled)
                            {
                                <span class="badge text-bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">No</span>
                            }
                        </dd>
                        <dt class="col-sm-4 text-body-secondary">Lockout enabled</dt>
                        <dd class="col-sm-8">
                            @if (Model.Profile.LockoutEnabled)
                            {
                                <span class="badge text-bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">No</span>
                            }
                        </dd>
                    </dl>
                }
                <div id="profileEdit" class="@(showEdit ? "" : "d-none")">
                    <form asp-controller="Account" asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="Profile.Email" class="form-label"></label>
                            <input asp-for="Profile.Email" class="form-control" autocomplete="email" spellcheck="false" />
                            <span asp-validation-for="Profile.Email" class="text-danger" role="alert"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Profile.PhoneNumber" class="form-label"></label>
                            <input asp-for="Profile.PhoneNumber" class="form-control" autocomplete="tel" inputmode="tel" />
                            <span asp-validation-for="Profile.PhoneNumber" class="text-danger" role="alert"></span>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Change password</div>
            <div class="card-body">
                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="ChangePassword.CurrentPassword" class="form-label"></label>
                        <input asp-for="ChangePassword.CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger" role="alert"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ChangePassword.NewPassword" class="form-label"></label>
                        <input asp-for="ChangePassword.NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ChangePassword.NewPassword" class="text-danger" role="alert"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ChangePassword.ConfirmPassword" class="form-label"></label>
                        <input asp-for="ChangePassword.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ChangePassword.ConfirmPassword" class="text-danger" role="alert"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Change password</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var btnEdit = document.getElementById('btnEditProfile');
            var display = document.getElementById('profileDisplay');
            var edit = document.getElementById('profileEdit');
            if (btnEdit && display && edit) {
                btnEdit.addEventListener('click', function () {
                    display.classList.add('d-none');
                    edit.classList.remove('d-none');
                    btnEdit.classList.add('d-none');
                });
            }
        })();
    </script>
}