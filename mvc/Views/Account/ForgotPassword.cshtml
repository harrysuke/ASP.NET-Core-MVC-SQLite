@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-1">Forgot your password?</h1>
                <p class="text-body-secondary mb-4">Enter your email address and we will send you a link to reset your password.</p>
                <form asp-controller="Account" asp-action="ForgotPassword" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" spellcheck="false" />
                        <span asp-validation-for="Email" class="text-danger" role="alert"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Submit</button>
                </form>
            </div>
        </div>
        <p class="text-center mt-3 mb-0">
            <a asp-controller="Account" asp-action="Login">Back to login</a>
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}