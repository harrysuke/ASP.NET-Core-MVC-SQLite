# Copy to .env and edit. Used by docker-compose.yml; never commit the real file.
# Docker Hub account that owns the image (also used by the CI workflow secret).
DOCKERHUB_USERNAME=your-dockerhub-username

# Image tag to run.
TAG=latest

# Host port mapped to the container's 8080.
APP_PORT=8080

# Bootstrap admin created on first start (leave blank to skip).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# Audit log retention in days; 0 disables the purge.
AUDIT_RETENTION_DAYS=180

# Optional SMTP settings for Identity emails (uncomment as a block).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_SSL=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME=Books
